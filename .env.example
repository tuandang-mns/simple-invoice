# Optional: copy to .env to override docker-compose defaults.  cp .env.example .env
# Every key has a local-demo default in docker-compose.yml, so `docker compose up` works without this file.

# --- Database ---
POSTGRES_USER=simpleinvoice
POSTGRES_PASSWORD=
POSTGRES_DB=simpleinvoice

# --- Backend ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
APP_TIMEZONE=Asia/Singapore
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL=60
LOG_LEVEL=info

# Demo login created by the seed (documented in README)
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=
SEED_USER_FULLNAME=Demo Admin

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:3000

# --- Host ports ---
DB_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080

# --- API docs ---
SWAGGER_ENABLED=true
