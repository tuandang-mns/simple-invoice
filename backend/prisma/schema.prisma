// SimpleInvoice data model — see docs/ARCHITECTURE.md §3.
// Constraints Prisma cannot express (CHECKs, case-insensitive unique, trigram indexes)
// are added by hand in the initial migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Persisted statuses only. "Overdue" is derived at read time and never stored.
enum InvoiceStatus {
  Draft
  Pending
  Paid
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullname     String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  invoices     Invoice[]
  sessions     Session[]

  @@map("users")
}

/// One row per sign-in. The access token carries its id (`sid`); the auth guard checks the row on
/// every request, so signing out (revokedAt) ends the session immediately, even for a copied token.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  invoiceNumber    String        @map("invoice_number")
  invoiceReference String?       @map("invoice_reference")
  invoiceDate      DateTime      @map("invoice_date") @db.Date
  dueDate          DateTime      @map("due_date") @db.Date
  currency         String        @db.Char(3)
  currencySymbol   String        @map("currency_symbol")
  description      String?
  status           InvoiceStatus @default(Draft)

  // Customer is embedded: an issued invoice keeps a snapshot of the customer at issue time.
  customerFullname String  @map("customer_fullname")
  customerEmail    String  @map("customer_email")
  customerMobile   String? @map("customer_mobile")
  customerAddress  String? @map("customer_address")

  taxRate         Decimal @map("tax_rate") @db.Decimal(5, 2)
  invoiceSubTotal Decimal @map("invoice_sub_total") @db.Decimal(18, 2)
  totalTax        Decimal @map("total_tax") @db.Decimal(18, 2)
  totalDiscount   Decimal @map("total_discount") @db.Decimal(18, 2)
  totalAmount     Decimal @map("total_amount") @db.Decimal(18, 2)
  totalPaid       Decimal @default(0) @map("total_paid") @db.Decimal(18, 2)
  balanceAmount   Decimal @map("balance_amount") @db.Decimal(18, 2)

  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String        @map("created_by") @db.Uuid
  creator   User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items     InvoiceItem[]

  @@index([invoiceDate])
  @@index([dueDate])
  @@index([totalAmount])
  @@index([createdAt])
  @@index([status, dueDate])
  @@index([createdBy])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  name      String
  quantity  Int
  rate      Decimal @db.Decimal(18, 2)
  amount    Decimal @db.Decimal(18, 2)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}
