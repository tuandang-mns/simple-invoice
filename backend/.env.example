# Copy to .env for local (non-Docker) development:  cp .env.example .env
NODE_ENV=development
PORT=3000

# PostgreSQL connection (docker compose exposes the DB on localhost:5432)
DATABASE_URL=postgresql://simpleinvoice:simpleinvoice@localhost:5432/simpleinvoice?schema=public

# JWT — use a long random value outside local dev:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Timezone used to decide what "today" is for Overdue derivation
APP_TIMEZONE=Asia/Singapore

# Login rate limit: max attempts per window (seconds)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL=60

LOG_LEVEL=info

# Demo account created by the seed script (demo credentials, not a secret)
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Demo Admin

# Serve Swagger UI at /api/docs (disable or protect in production)
SWAGGER_ENABLED=true
